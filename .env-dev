# RDS Server Development environment
APP_PROFILE=dev
RDS_PORT=8087

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=root
DB_PASSWORD=root
DB_NAME=rds_db2
DB_SSLMODE=disable

# NATS Configuration
NATS_URL=nats://localhost:4222
NATS_USER=auth-server
NATS_PASSWORD=auth-secret

# Server Settings
PUBLIC_HOST_IP=localhost
AWS_REGION=eu-north-1
METRICS_SERVER_URL=http://localhost:8099/api/v1/metrics-server
