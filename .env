# RDS Server Base environment
APP_PROFILE=dev
RDS_PORT=8087
SERVICE_NAME=rds-server

# Default Database Settings
DB_HOST=localhost
DB_PORT=5432
DB_USER=root
DB_PASSWORD=root
DB_NAME=rds_db2
DB_SSLMODE=disable

# Default NATS Settings
NATS_URL=nats://localhost:4222
NATS_USER=auth-server
NATS_PASSWORD=auth-secret

# Region
AWS_REGION=eu-north-1
