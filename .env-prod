# RDS Server Production environment
APP_PROFILE=prod
RDS_PORT=8087

# Database Configuration
DB_HOST=postgres-prod
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=YOUR_PROD_PASSWORD
DB_NAME=rds_db2
DB_SSLMODE=require

# NATS Configuration
NATS_URL=nats://nats-prod:4222
NATS_USER=auth-server
NATS_PASSWORD=YOUR_NATS_PASSWORD

# Server Settings
PUBLIC_HOST_IP=YOUR_PUBLIC_IP
AWS_REGION=eu-north-1
METRICS_SERVER_URL=http://metrics-server:8099/api/v1/metrics-server
