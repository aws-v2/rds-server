# RDS Server Staging Local Template
# Use this to run the staging profile on your local machine connecting to localhost services

APP_PROFILE=staging
RDS_PORT=8087

# Database Configuration (Assuming local tunnels to staging DB or local DB)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_staging_db_password
DB_NAME=rds_db
DB_SSLMODE=disable

# NATS Configuration (Assuming local tunnel to staging NATS or local NATS)
NATS_URL=nats://localhost:4222
NATS_USER=auth-server
NATS_PASSWORD=your_staging_nats_password

# Server Settings
PUBLIC_HOST_IP=localhost
AWS_REGION=eu-north-1
METRICS_SERVER_URL=http://localhost:8099/api/v1/metrics-server
